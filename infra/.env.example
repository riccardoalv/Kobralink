# Image to run (pin a version: ghcr.io/riccardoalv/farolprint:0.12.0, or a commit: ghcr.io/riccardoalv/farolprint:sha-<commit>)
FAROLPRINT_IMAGE=ghcr.io/riccardoalv/farolprint:latest

# Host interface to listen on (0.0.0.0 = all, 127.0.0.1 = behind a reverse proxy)
FAROLPRINT_BIND=0.0.0.0
FAROLPRINT_PORT=7100

# URL actually typed in the browser (cookies + Better Auth trusted origin)
BETTER_AUTH_URL=http://farolprint.local:7100

# Time zone of the server (time-based automations, daily statistics). The container uses UTC without it.
# TZ=America/Sao_Paulo

# Session secret: generated in /data/.auth-secret when missing.
# To set it yourself: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Extra allowed origins (CORS + Better Auth), comma-separated
# FAROLPRINT_EXTRA_ORIGINS=https://farolprint.example.com

# Behind a reverse proxy: proxy IPs/CIDRs (Better Auth rate limiting by real client IP)
# FAROLPRINT_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# Or a single header set by the proxy (e.g. Cloudflare)
# FAROLPRINT_IP_HEADERS=cf-connecting-ip
