# Image à déployer (épingler une version : ghcr.io/riccardoalv/farolprint:0.3.6 ou un commit : ghcr.io/riccardoalv/farolprint:sha-<commit>)
FAROLPRINT_IMAGE=ghcr.io/riccardoalv/farolprint:latest

# Interface d'écoute sur l'hôte (0.0.0.0 = toutes, 127.0.0.1 = derrière un reverse proxy)
FAROLPRINT_BIND=0.0.0.0
FAROLPRINT_PORT=7100

# URL réellement utilisée par le navigateur (cookies + origine de confiance Better Auth)
BETTER_AUTH_URL=http://farolprint.local:7100

# Secret de session : généré dans /data/.auth-secret si absent.
# Pour le fixer : openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Origines supplémentaires autorisées (CORS + Better Auth), séparées par des virgules
# FAROLPRINT_EXTRA_ORIGINS=https://farolprint.example.com

# Derrière un reverse proxy : IPs/CIDR des proxies (rate limiting Better Auth par IP client réelle)
# FAROLPRINT_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# Ou en-tête unique posé par le proxy (ex. Cloudflare)
# FAROLPRINT_IP_HEADERS=cf-connecting-ip
